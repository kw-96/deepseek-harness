{
  "name": "dsh-plugin-browser",
  "version": "1.1.0",
  "description": "In-app browser pane for DeepSeek Harness: a real Chrome driven over CDP and shared with the official browser-use attach provider, plus rendered previews of local files, markdown and PDFs.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "browser",
    "cdp",
    "preview",
    "pdf"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cdpbrowser.js",
    "filerender.js",
    "pdfrender.js",
    "webproxy.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  }
}
