{
  "name": "dsh-desktop-panel",
  "version": "0.2.0",
  "description": "DSH 桌面面板：在浏览器里查看并操作当前控制台桌面（含锁屏界面），设置页提供启停开关与访问地址",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-desktop",
    "desktop-panel",
    "web-ui"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/ws.js",
    "lib/panel.js",
    "native",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.ts"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
