{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
